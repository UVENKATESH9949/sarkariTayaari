# Copy to .env.local and adjust. Vite only exposes variables prefixed with VITE_.

# Where the backend lives. Must include the /api suffix — the shared API client appends
# paths like /exams directly to it.
#
# Local development against a backend started with `mvn -f backend/pom.xml spring-boot:run`:
VITE_API_BASE_URL=http://localhost:8080/api

# Deployed backend (Cloud Run), for pointing a local web build at real data:
# VITE_API_BASE_URL=https://sarkaritaiyaari-backend-815653276881.asia-south1.run.app/api
#
# NOTE: the backend pins CORS to an exact allowlist (app.cors.allowed-origins /
# APP_CORS_ALLOWED_ORIGINS). Whichever origin you serve this app from must be in it, scheme
# included — http://localhost:5174 and http://127.0.0.1:5174 are different origins.
