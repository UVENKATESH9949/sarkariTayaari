spring:
  datasource:
    url: jdbc:postgresql://<your-neon-host>/<your-db-name>?sslmode=require
    username: <your-neon-username>
    password: <your-neon-password>

cloudinary:
  cloud-name: FILL_ME_IN
  api-key: FILL_ME_IN
  api-secret: FILL_ME_IN

# Optional. Creates a single ADMIN-role user on startup if no admin exists yet — this is
# how the very first admin account gets created (public sign-up always creates a
# STUDENT). Leave both blank/omitted to skip bootstrap; safe to leave set afterwards,
# since it's a no-op once any admin exists. Once you have one admin, sign in to the
# admin console and use it to create teammates via POST /api/auth/admin/register.
admin:
  bootstrap-email:
  bootstrap-password:

# Optional. Turn on to allow seeding synthetic Epic L curation data (topic hierarchy,
# prerequisites, exam topic map, PYQ years) via
# POST /api/admin/synthetic-curation/seed, and to remove it again via .../purge.
# Local development only — never set this on a deployed instance.
app:
  epic-l:
    synthetic-seed-enabled: true

# Optional. Turn on to allow seeding a demo SSC CGL recruitment cycle (Exam Guide Phase 1)
# via POST /api/admin/exam-guide-demo/seed, and to remove it via .../purge. Local
# development only — never set this on a deployed instance.
  exam-guide:
    demo-seed-enabled: true
