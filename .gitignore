# --- Secrets ---------------------------------------------------------------
# Real credentials live here (Neon password, Cloudinary keys). backend/.gitignore
# already covers it; repeated at root as a second line of defence, because a single
# accidental `git add -f` or a moved file is all it takes.
application-local.yml
**/application-local.yml
.env
.env.*
!.env.example

# Signing material — never commit these, even for debug builds.
*.keystore
*.jks
*.p12
*.pem
key.properties

# --- Build output ----------------------------------------------------------
node_modules/
dist/
build/
target/
.gradle/
local.properties
*.apk
*.aab
# Build artefacts served over HTTP for device testing — never committed.
downloads/

# --- Expo / React Native ---------------------------------------------------
.expo/
.expo-shared/
web-build/
*.tsbuildinfo

# Native projects are generated by `expo prebuild` (Continuous Native Generation)
# rather than committed. app.json is the source of truth; CI regenerates these,
# so an edit made directly in android/ would be silently discarded.
mobile/android/
mobile/ios/

# --- Editors / OS ----------------------------------------------------------
.idea/
*.iml
.DS_Store
Thumbs.db

# --- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*

# --- Device debugging artefacts --------------------------------------------
# uiautomator dumps captured while driving the emulator; not project files.
dump*.xml
