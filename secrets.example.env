# ==============================================================================
# SarkariTaiyaari - every secret and machine-specific setting, in one place.
#
# THIS FILE IS GITIGNORED AND MUST STAY THAT WAY. It holds live credentials.
#
# It is the SINGLE SOURCE OF TRUTH. Do not hand-edit the per-system files
# (backend/application-local.yml, mobile/.env.local, web/.env.local,
# admin/.env.local, studio/.env) - they are GENERATED from this one.
#
#   Edit this file, then run:   npm run secrets:apply
#
# Fill in any blank value below. A blank is left blank on purpose rather than
# carrying a placeholder forward, so "empty" always means "not set yet".
# ==============================================================================

# ----------------------------------------------------------------------------
# DATABASE - backend. From the Neon console.
#   WARNING: dev and production share ONE Neon database. Anything you do
#   locally is production data. Long-standing open item, not a design choice.
# ----------------------------------------------------------------------------
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ----------------------------------------------------------------------------
# CLOUDINARY - backend only. From the Cloudinary dashboard.
#   Used for question images, ingested PDFs AND lesson videos. The api-secret
#   is server-side only and must never reach mobile, admin or web.
#   Production already has these in Secret Manager as `cloudinary-secret`.
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------------------------------------------------
# VIDEO STORAGE - backend.
#   local  = writes under ./var. Needs no credentials, so a fresh checkout works.
#            WRONG on Cloud Run: ephemeral filesystem, scales to zero.
#   cloudinary = the real deployment setting. Reuses the Cloudinary account above,
#            so it needs no new credentials.
#   url-ttl only matters for cloudinary, and only if the plan supports expiring links.
# ----------------------------------------------------------------------------
VIDEO_STORAGE_PROVIDER=
VIDEO_STORAGE_URL_TTL_SECONDS=

# ----------------------------------------------------------------------------
# AI PROVIDER - backend. From the Groq console (or Anthropic).
#   APP_AI_ENCRYPTION_KEY is a base64 AES-256 key (exactly 44 characters) and is
#   the ONE value that must reach a deployment as an env var - it is deliberately
#   never stored in the database. A trailing newline breaks it: the strict base64
#   decoder rejects it and the application fails to start.
# ----------------------------------------------------------------------------
APP_AI_ENABLED=
APP_AI_PROVIDER=
APP_AI_API_KEY=
APP_AI_MODEL=
APP_AI_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# DOCUMENT STORAGE - backend.
#   true = do not really upload. Set false once CLOUDINARY_* above are real.
# ----------------------------------------------------------------------------
APP_DOCUMENT_STORAGE_FAKE=

# ----------------------------------------------------------------------------
# FIRST ADMIN ACCOUNT - backend. Creates one ADMIN user at startup.
#   Only acts when no admin exists yet; a no-op afterwards, so it is safe to leave set.
#   Public sign-up always creates a STUDENT, so this is how the first admin appears.
# ----------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ----------------------------------------------------------------------------
# EMAIL - backend. Sends the one-time sign-in codes.
#   SPRING_MAIL_PASSWORD is a 16-character Google APP PASSWORD, never the account
#   password. With APP_MAIL_ENABLED=false the code is written to the backend log
#   instead of being emailed, which is how local sign-in works with no mail set up.
# ----------------------------------------------------------------------------
APP_MAIL_ENABLED=
APP_MAIL_FROM=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ----------------------------------------------------------------------------
# GOOGLE SIGN-IN - backend + mobile. NOT a secret; a public client id.
#   Both must be the WEB client id, including on Android - the Android clients exist
#   only so Google will sign the token, and the backend verifies the `aud` against
#   the web one. Leave blank to use the built-in default already in application.yml.
# ----------------------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ----------------------------------------------------------------------------
# MOBILE APP
#   10.0.2.2 is the Android emulator's alias for THIS machine. It BYPASSES
#   `adb reverse` entirely - the most expensive trap in this project's history.
#   Metro inlines this at bundle time, so changing it needs a Metro restart
#   (--clear), not a native rebuild.
# ----------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SENTRY_DSN=

# ----------------------------------------------------------------------------
# WEB AND ADMIN CONSOLES
#   Admin falls back to http://localhost:8080 when blank, so it is optional.
#   CORS is pinned to exact origins: 127.0.0.1:5173 is a DIFFERENT origin from
#   localhost:5173 and fails with a CORS error, not a helpful one.
# ----------------------------------------------------------------------------
WEB_VITE_API_BASE_URL=
ADMIN_VITE_API_BASE_URL=

# ----------------------------------------------------------------------------
# AI VIDEO STUDIO - studio/ only.
#   Only needed to swap narration from the local Windows voice to OpenAI TTS.
#   The studio runs fine without it using local SAPI.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# CI / GITHUB ACTIONS - reference only, NOT read by anything locally.
#   These live as GitHub repository secrets. Listed here so the inventory is complete
#   and nobody has to go hunting for what a build needs.
#   ANDROID_KEYSTORE_BASE64 is the upload keystore. Losing it means no existing
#   install can ever be updated - back it up somewhere other than this laptop.
# ----------------------------------------------------------------------------
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

